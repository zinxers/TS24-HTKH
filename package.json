{
  "name": "ts24-htkh",
  "private": true,
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:root": "vitest run",
    "check:rls": "pnpm --filter @ts24-htkh/db check:rls",
    "depcruise": "depcruise apps packages tools --config .dependency-cruiser.cjs --include-only \"^(apps|packages|tools)/[^/]+/src/\""
  },
  "devDependencies": {
    "@ts24-htkh/config": "workspace:*",
    "dependency-cruiser": "^18.7.2",
    "supabase": "^3.1.0",
    "turbo": "^2.11.11",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0"
  }
}
